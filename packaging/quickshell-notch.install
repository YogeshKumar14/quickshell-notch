post_install() {
    echo ":: Updating system font cache..."
    fc-cache -s >/dev/null 2>&1 || true

    cat <<'EOF'

==> QuickShell Top Notch installed successfully!
==> Quick Start:
    1. Initialize your user configuration:
       $ quickshell-notch init

    2. Add autostart & persistence to ~/.config/hypr/hyprland.lua:
       hl.on("hyprland.start", function()
           hl.exec_cmd("quickshell-notch launch")
       end)
       pcall(dofile, os.getenv("HOME") .. "/.config/hypr/quickshell_hypr.lua")
       hl.bind("SUPER + N", hl.dsp.exec_cmd("quickshell-notch toggle"))

EOF
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ":: Updating system font cache..."
    fc-cache -s >/dev/null 2>&1 || true
    echo "==> QuickShell Top Notch package removed."
    echo "==> Note: User configurations in ~/.config/quickshell were preserved."
}
